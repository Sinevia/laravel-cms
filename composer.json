{
    "name": "sinevia/laravel-cms",
    "type": "library",
    "description": "Content Management System for Laravel",
    "keywords": [
        "Sinevia",
        "Laravel",
        "CMS"
    ],
    "homepage": "https://github.com/Sinevia/Cms",
    "license": "proprietary",
    "authors": [
        {
            "name": "Milan Lesichkov",
            "email": "lesichkovm@gmail.com",
            "homepage": "http://lesichkov.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "illuminate/support": "5.*|6.*|7.*|8.*|9.*|10.*|11.*|12.*|13.*",
        "lesichkovm/laravel-advanced-model": "^1.9",
        "lesichkovm/laravel-advanced-route": "^1.12",
        "php": "~5.6|~7.0|~8.0|~9.0"
    },
    "require-dev": {
        "orchestra/testbench-core": "^10.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Sinevia\\Cms\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sinevia\\Cms\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests",
        "fix-style": "phpcbf -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sinevia\\Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "Sinevia\\Cms\\Facade"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
